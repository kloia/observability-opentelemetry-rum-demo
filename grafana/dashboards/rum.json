{
  "title": "RUM: Juice Shop (OpenTelemetry Web SDK)",
  "uid": "rum-juice-shop",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Page load duration (p95)",
      "description": "documentLoad spans from the browser. TraceQL metrics, no Prometheus involved.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-frontend\" && name = \"documentLoad\" } | quantile_over_time(duration, .95)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Click rate",
      "description": "UserInteractionInstrumentation click spans from the browser.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-frontend\" && span.event_type = \"click\" } | rate()"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Frontend fetch rate",
      "description": "FetchInstrumentation client spans — every API call the browser made.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-frontend\" && name = \"GET\" } | rate()"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Backend request rate by route",
      "description": "Correlated server spans — the other end of the same-origin fetch calls above.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": { "defaults": { "unit": "cps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-backend\" && kind = server } | rate() by (span.http.route)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Backend latency by route (p95)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "datasource": { "type": "tempo", "uid": "tempo" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "tempo", "uid": "tempo" },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-backend\" && kind = server } | quantile_over_time(duration, .95) by (span.http.route)"
        }
      ]
    }
  ]
}
