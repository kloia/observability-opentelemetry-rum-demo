{
  "title": "Business RUM: what users feel",
  "uid": "rum-business",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Login success",
      "description": "Share of login attempts the server accepted (HTTP 200). A 401 is a refused login.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "({ resource.service.name = \"juice-shop-backend\" && kind = server && span.http.route = \"/rest/user/login\" && span.http.response.status_code = 200 } | rate()) / ({ resource.service.name = \"juice-shop-backend\" && kind = server && span.http.route = \"/rest/user/login\" } | rate())",
          "metricsQueryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Apdex (user satisfaction)",
      "description": "1.0 = every API call felt fast. Fast < 500 ms counts 1, tolerable < 2 s counts half, slower counts 0. 0.94+ is excellent, below 0.7 is poor.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "(({ resource.service.name = \"juice-shop-frontend\" && kind = client && duration < 500ms } | rate()) + ({ resource.service.name = \"juice-shop-frontend\" && kind = client && duration >= 500ms && duration < 2s } | rate()) / 2) / ({ resource.service.name = \"juice-shop-frontend\" && kind = client } | rate())",
          "metricsQueryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "yellow",
                "value": 0.85
              },
              {
                "color": "green",
                "value": 0.94
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Basket to order",
      "description": "Orders placed divided by items added to a basket. Not a per-shopper conversion, see the post.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "({ resource.service.name = \"juice-shop-backend\" && kind = server && span.http.route = \"/rest/basket/:id/checkout\" } | rate()) / ({ resource.service.name = \"juice-shop-backend\" && kind = server && span.http.request.method = \"POST\" && span.http.route = \"/api/BasketItems\" } | rate())",
          "metricsQueryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "API errors",
      "description": "Share of the browser's API calls answered with 4xx or 5xx. Includes refused logins.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "({ resource.service.name = \"juice-shop-frontend\" && kind = client && span.http.response.status_code >= 400 } | rate()) / ({ resource.service.name = \"juice-shop-frontend\" && kind = client } | rate())",
          "metricsQueryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Login attempts by outcome",
      "description": "POST /rest/user/login on the server. 200 = signed in, 401 = refused.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-backend\" && kind = server && span.http.route = \"/rest/user/login\" } | rate() by (span.http.response.status_code)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "User-perceived latency (p50 / p95 / p99)",
      "description": "What the browser waited for on API calls, not what the server measured.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-frontend\" && kind = client } | quantile_over_time(duration, .5, .95, .99)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Gap: browser vs server (p95)",
      "description": "Same kind of requests, two clocks. The distance between the lines is network, browser and everything the backend never sees.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ (resource.service.name = \"juice-shop-frontend\" && kind = client) || (resource.service.name = \"juice-shop-backend\" && kind = server) } | quantile_over_time(duration, .95) by (resource.service.name)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Page views by route",
      "description": "navigation spans from hashchange. documentLoad only fires once per tab in a single-page app.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-frontend\" && name = \"navigation\" } | rate() by (span.route)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "What people search for",
      "description": "Search terms typed in the shop's search bar (lowercase, 40 characters max). User-typed text: decide if you want it before you ship it.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-frontend\" && span.search.term != nil } | count_over_time() by (span.search.term)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Products added to basket",
      "description": "Product name of every Add to Basket click, guests included.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-frontend\" && span.product.name != nil } | count_over_time() by (span.product.name)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "sum"
          ]
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Clicks by element",
      "description": "Click spans are named after what was clicked (id, else label).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-frontend\" && span.event_type = \"click\" } | rate() by (name)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Errors users hit",
      "description": "Failed API calls (4xx, 5xx) and JavaScript errors from the browser.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ (resource.service.name = \"juice-shop-frontend\" && kind = client && span.http.response.status_code >= 400) || (resource.service.name = \"juice-shop-frontend\" && name = \"exception\") } | rate() by (name)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Checkout funnel (backend calls per route)",
      "description": "POST /api/BasketItems = add to basket, GET /rest/basket/:id = view basket, POST .../checkout = place order.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"juice-shop-backend\" && kind = server && ((kind = server && span.http.request.method = \"POST\" && span.http.route = \"/api/BasketItems\") || span.http.route = \"/rest/basket/:id\" || span.http.route = \"/rest/basket/:id/checkout\") } | rate() by (span.http.route)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps"
        },
        "overrides": []
      }
    }
  ]
}
